@startuml ConfirmPaySequence_Final
skinparam maxMessageSize 150
skinparam ParticipantPadding 10
skinparam BoxPadding 10
skinparam monochrome true

actor Client
boundary "API: confirm_pay" as API
participant "restaurant\n:Restaurant" as Rest
participant "staff\n:Staff" as Staff
participant "order\n:Order" as Order
participant "customer\n:Member" as Member
participant "coupon\n:Coupon" as Coupon
participant "booking\n:Booking" as Booking
participant "delivery\n:Delivery" as Delivery
participant "method\n:PaymentMethod" as Method
participant "receipt\n:Receipt" as Receipt

Client -> API : POST confirm_pay(order_id, staff_id, method, coupon_code, details)
activate API

' Thin API Delegate to Restaurant
API -> Rest : process_order_payment(order_id, staff_id, coupon_code, method, details)
activate Rest

' 1. Validations & Setup
Rest -> Rest : method = get_payment_method(method)
Rest -> Rest : staff = get_staff(staff_id)
Rest -> Rest : order = get_order(order_id)

opt Validation Fails (Event without PartyStaff OR Already Paid)
    Rest --> API : Raise HTTPException(400)
end

' 2. Delegate Payment Execution to Order
Rest -> Order : execute_payment(method, details, coupon_code)
activate Order

    opt coupon_code provided
        alt isinstance(order.customer, Member)
            Order -> Member : get_coupon_by_code(coupon_code)
            activate Member
            Member --> Order : coupon
            deactivate Member
        else
            Order --> Rest : Raise ValueError("Only members can use coupons")
        end
    end

    ' 2.1 Calculate Totals Inside Order
    Order -> Order : calculate_totals(coupon_code)
    activate Order
        Order -> Order : base_subtotal = sum(order_item.price)
        
        opt has booking
            Order -> Booking : full_price / deposit
            activate Booking
            Booking --> Order
            deactivate Booking
        end
        
        opt has delivery
            Order -> Delivery : fee
            activate Delivery
            Delivery --> Order
            deactivate Delivery
        end
        
        opt coupon exists
            Order -> Coupon : apply_coupon(subtotal)
            activate Coupon
            Coupon --> Order : discount
            deactivate Coupon
        end
    deactivate Order

    ' 2.2 Payment Gateway
    Order -> Method : pay(total_payable, **details)
    activate Method
    Method --> Order : (success, note)
    deactivate Method

    ' 2.3 Post-Payment Updates
    alt success == True
        Order -> Order : status = PAID
        
        opt has booking
            Order -> Booking : mark_checked_in()
            activate Booking
            Booking -> Booking : room.mark_room_in_use()
            deactivate Booking
        end
        
        opt has delivery
            Order -> Delivery : mark_as_paid()
            activate Delivery
            Delivery --> Order
            deactivate Delivery
        end
        
        opt coupon exists
            Order -> Coupon : mark_as_used()
        end
        
        ' 2.4 Receipt Generation
        Order -> Receipt ** : <<create>> Receipt(self, method)
        opt isinstance(order.customer, Member)
            Order -> Member : add_receipt(receipt)
        end
        
        Order --> Rest : receipt
    else success == False
        Order --> Rest : Raise HTTPException(400, note)
    end
deactivate Order

' 3. Save Receipt and Issue Rewards
Rest -> Rest : add_recipts(receipt)

opt check_and_issue_reward() conditions met
    Rest -> Rest : reward_coupon = <<create>> Coupon()
    Rest -> Member : add_coupon(reward_coupon)
    activate Member
    Member --> Rest
    deactivate Member
end

Rest -> Receipt : generate()
activate Receipt
Receipt --> Rest : receipt_json
deactivate Receipt

opt reward_issued
    Rest -> Rest : Add "reward_issued" to receipt_json
end

Rest --> API : receipt_json
deactivate Rest

API --> Client : Return 200 OK (Receipt JSON)
deactivate API
@enduml